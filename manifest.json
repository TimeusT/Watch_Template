{
  "manifest_version": 3,
  "name": "Watch Template Generator",
  "version": "1.0",
  "description": "Generate watch templates from IMDb pages.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://www.imdb.com/*",
    "*://m.media-amazon.com/*",
    "*://*.imdb.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "main.html",
    "default_icon": "Images/icon.png"
    }
}